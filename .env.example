RA_WEBSITE_URL=https://example.com/ra-recruitment-page
CHECK_INTERVAL_MINUTES=360
MIN_SCORE=2

DB_BACKEND=sqlite
SQLITE_PATH=data/ra_agent.sqlite
DATABASE_URL=postgresql://user:your_password@host:5432/database
DATA_RETENTION_DAYS=90
SEEN_POST_TOUCH_INTERVAL_HOURS=24

AUTH_SECRET=generate_with_npx_auth_secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret
# Optional local-only bypass. Only works when NODE_ENV=development.
DISABLE_AUTH_IN_DEV=false
# GitHub OAuth callback URL:
# Local: http://localhost:3000/api/auth/callback/github
# Production: https://your-domain.example/api/auth/callback/github

GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
GMAIL_TO=yourgmail@gmail.com
GMAIL_FROM=yourgmail@gmail.com

USE_LLM_CLASSIFIER=true
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

USE_SYSTEM_PROXY=false
